---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { COPY } from '../data/site.js';
import { UI } from '../data/content.js';
import { t } from '../lib/i18n.js';

interface Props { lang: string }
const { lang } = Astro.props;
---
<Base lang={lang} slug="estimate" title={t(COPY.estimate.title, lang)} description={t(UI.estLead, lang)}>
  <PageHero lang={lang} place="amalfi" kicker={t(COPY.estimate.title, lang)} title={t(UI.estTitle, lang)} lead={t(UI.estLead, lang)} short video={false} />
  <div class="horizon"></div>
  <section class="paper section" style="padding-top:clamp(2rem,5vw,4rem)">
    <div class="wrap">
      <div id="calc-main" class="est-grid" data-sent={t(COPY.estimate.sent, lang)}>
        <noscript><p>{lang === 'es' ? 'El calculador necesita JavaScript. Los precios están en cada página de servicio.' : 'The calculator needs JavaScript. Prices are listed on each service page.'}</p></noscript>
      </div>
    </div>
  </section>
  <div class="horizon to-night"></div>
</Base>
