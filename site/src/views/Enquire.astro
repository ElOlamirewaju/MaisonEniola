---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { COPY } from '../data/site.js';
import { UI, CONTACT } from '../data/content.js';
import { t } from '../lib/i18n.js';
import { ICON } from '../lib/icons.js';

interface Props { lang: string }
const { lang } = Astro.props;
const E = COPY.enquire;
---
<Base lang={lang} slug="enquire" title={t(E.title, lang)} description={t(UI.enqLead, lang)}>
  <PageHero lang={lang} place="lisbon" kicker={t(E.kicker, lang)} title={t(UI.enqTitle, lang)} lead={t(UI.enqLead, lang)} short video={false} />
  <div class="horizon"></div>
  <section class="paper section" style="padding-top:clamp(2rem,5vw,4rem)">
    <div class="wrap">
      <form class="enq" id="enq" novalidate>
        <noscript><p>{lang === 'es' ? `El formulario necesita JavaScript. Escríbeme por WhatsApp al ${CONTACT.waLabel} o a ${CONTACT.email}.` : `The form needs JavaScript. Message me on WhatsApp at ${CONTACT.waLabel} or email ${CONTACT.email}.`}</p></noscript>
      </form>
      <div class="cta-band" style="max-width:760px;margin-inline:auto">
        <h2>{t(E.elsewhere, lang)}</h2>
        <div class="acts">
          <a class="btn btn-wa" href={`https://wa.me/${CONTACT.wa}`} target="_blank" rel="noopener"><Fragment set:html={ICON.wa} />WhatsApp {CONTACT.waLabel}</a>
          <a class="btn btn-ghost" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="horizon to-night"></div>
</Base>
