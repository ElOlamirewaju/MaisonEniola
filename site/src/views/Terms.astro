---
/* Terms of Service: every service's payment and cancellation terms, the page the checkout tick links to. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TermsTabs from '../components/TermsTabs.astro';
import { SERVICES, UI } from '../data/content.js';
import { COPY, SERVICE_PAGES } from '../data/site.js';
import { t, href } from '../lib/i18n.js';

interface Props { lang: string }
const { lang } = Astro.props;
const T = COPY.terms;
const pages = SERVICE_PAGES.map(sp => ({ sp, s: SERVICES[sp.index] }));
---
<Base lang={lang} slug="terms" title={t(T.title, lang)} description={t(T.lead, lang)}>
  <PageHero lang={lang} place="lisbon" kicker={t(T.kicker, lang)} title={t(T.title, lang)} lead={t(T.lead, lang)} short video={false} />
  <div class="horizon"></div>
  <section class="paper section">
    <div class="wrap terms-page">
      <nav class="terms-jump" aria-label={t(T.jump, lang)}>
        {pages.map(({ sp, s }) => <a href={`#terms-${s.key}`}>{t(s.short, lang)}</a>)}
      </nav>
      {pages.map(({ sp, s }) => (
        <section class="terms-svc" aria-labelledby={`h-${s.key}`}>
          <h2 class="title-l" id={`h-${s.key}`}>{t(s.short, lang)}</h2>
          <p class="terms-svc-link"><a href={href(lang, sp.slug)}>{t(T.seeLevels, lang)} →</a></p>
          <TermsTabs lang={lang} groups={s.terms} id={`terms-${s.key}`} />
        </section>
      ))}
      <p class="price-validity" style="margin-top:2.5rem">{t(UI.priceValidity, lang)}</p>
    </div>
  </section>
  <div class="horizon to-night"></div>
</Base>
