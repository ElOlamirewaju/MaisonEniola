---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCall from '../components/FinalCall.astro';
import { COPY } from '../data/site.js';
import { UI } from '../data/content.js';
import { t } from '../lib/i18n.js';

interface Props { lang: string }
const { lang } = Astro.props;
const A = COPY.about, H = COPY.home;
---
<Base lang={lang} slug="about" title={t(A.title, lang)} description={t(A.lead, lang)}>
  <PageHero lang={lang} place="lisbon" kicker={t(A.kicker, lang)} title={t(A.heading, lang)} lead={t(A.lead, lang)} short />
  <section class="scene">
    <div class="wrap about-grid">
      <figure class="portrait has-photo" data-reveal>
        <img src="/images/maryann-portrait-800.webp" srcset="/images/maryann-portrait-800.webp 800w, /images/maryann-portrait-1600.webp 1600w" sizes="(min-width: 960px) 34vw, 100vw" width="800" height="1000" alt={t(A.portraitAlt, lang)} decoding="async" loading="lazy" />
      </figure>
      <div style="display:grid;gap:2rem">
        <p class="placeholder" data-reveal style="--d:1">{t(A.storyPlaceholder, lang)}</p>
        <div class="bound-night" data-reveal style="--d:2">
          <h2 class="title-l" style="font-size:1.6rem">{t(UI.boundTitle, lang)}</h2>
          <p>{t(UI.boundText, lang)}</p>
        </div>
        <div>
          <h2 class="title-l" data-reveal style="--d:3;font-size:1.6rem;margin-bottom:1rem">{t(A.principlesTitle, lang)}</h2>
          <div class="promises" style="grid-template-columns:1fr">
            {H.promises.map((p, i) => <div class="promise" data-reveal style={`--d:${i + 3};padding-left:0;border-left:0`}><h3>{t(p.title, lang)}</h3><p>{t(p.text, lang)}</p></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  <FinalCall lang={lang} place="mallorca" />
</Base>
