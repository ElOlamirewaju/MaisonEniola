---
import Base from '../layouts/Base.astro';
import FinalCall from '../components/FinalCall.astro';
import { COPY } from '../data/site.js';
import { t } from '../lib/i18n.js';

interface Props { lang: string }
const { lang } = Astro.props;
const N = COPY.notFound;
---
<Base lang={lang} slug="404" title="404">
  <FinalCall lang={lang} place="iceland" title={t(N.title, lang)} text={t(N.text, lang)} />
</Base>
