---
/* Client reviews. With none yet, an honest placeholder scene; never sample text that could read as real. */
import Media from './Media.astro';
import { REVIEWS } from '../data/reviews.js';
import { COPY } from '../data/site.js';
import { t, href } from '../lib/i18n.js';
import { ICON } from '../lib/icons.js';

interface Props { lang: string; limit?: number; link?: boolean }
const { lang, limit, link = false } = Astro.props;
const R = COPY.reviews;
const list = limit ? REVIEWS.slice(0, limit) : REVIEWS;
const fmt = d => { const [y, m] = d.split('-'); return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { month: 'long', year: 'numeric' }).format(new Date(+y, +m - 1, 1)); };
---
{list.length === 0 ? (
  <div class="voices-empty" data-reveal>
    <Media place="mallorca" lang={lang} parallax={0.1} decorative />
    <span class="quote-mark" aria-hidden="true">“</span>
    <h3 class="title-l">{t(R.emptyTitle, lang)}</h3>
    <p>{t(R.emptyText, lang)}</p>
    {link && <a class="btn btn-glass" href={href(lang, 'reviews')}>{t(R.shareTitle, lang)}<Fragment set:html={ICON.arrow} /></a>}
  </div>
) : (
  <div class:list={['review-grid', { three: list.length >= 3 }]}>
    {list.map((r, i) => {
      const text = lang !== r.lang && r.translation?.[lang] ? r.translation[lang] : r.text;
      return (
        <article class="review" data-reveal style={`--d:${i % 3}`}>
          {r.place && <Media place={r.place} lang={lang} decorative />}
          <span class="quote-mark" aria-hidden="true">“</span>
          <blockquote lang={lang !== r.lang && r.translation?.[lang] ? lang : r.lang}>{text}</blockquote>
          <footer>
            <b>{r.name}</b>
            <span>{t(r.trip, lang)} · {fmt(r.date)}</span>
            {r.source && <span class="orig">{r.sourceUrl ? <a href={r.sourceUrl} target="_blank" rel="noopener">{r.source}</a> : r.source}</span>}
          </footer>
        </article>
      );
    })}
  </div>
)}
