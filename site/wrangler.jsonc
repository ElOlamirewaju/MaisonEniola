{
  // Cloudflare Workers static-assets deploy. No Worker script: the built site in dist/ is served directly.
  // The Worker name in the Cloudflare dashboard must match "name" below.
  "name": "maisoneniola",
  "compatibility_date": "2026-09-16",
  // The workers.dev and preview URLs stay off: the site is reached at maisoneniola.bid only.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
