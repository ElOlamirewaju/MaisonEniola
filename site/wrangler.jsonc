{
  // Cloudflare Workers deploy: the static build in dist/ plus a tiny script that only handles /api/enquiry.
  // The Worker name in the Cloudflare dashboard must match "name" below.
  "name": "maisoneniola",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-16",
  // The workers.dev and preview URLs stay off: the site is reached at maisoneniola.bid only.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Email Sending must be enabled for maisoneniola.bid (dashboard: Email Service > Email Sending > Onboard domain).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ENQUIRY_TO": "maisoneniola@gmail.com",
    "ENQUIRY_FROM": "enquiries@maisoneniola.bid"
  },
  "observability": { "enabled": true }
}
